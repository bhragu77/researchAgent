# Copy to .env and fill in. No real values belong in this file.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Datastores ---
POSTGRES_URL=postgresql://research:research@localhost:5433/research
REDIS_URL=redis://127.0.0.1:6381/0

# --- Auth (Phase 4) ---
# Tenant identity comes only from the verified `tid` JWT claim. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=research-agent
JWT_AUDIENCE=research-api
JWT_TTL_SECONDS=3600
# POST /v1/token mints tenant credentials without authenticating the caller.
# MUST be false in any real deployment.
ENABLE_DEV_TOKEN_ENDPOINT=true

# --- OAuth sign-in ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized JS origin: OAUTH_PUBLIC_BASE_URL below.
# Authorized redirect URI: ${OAUTH_PUBLIC_BASE_URL}/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# Authorization callback URL: ${OAUTH_PUBLIC_BASE_URL}/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# This server's own externally-reachable origin (must match what you register
# above) and where the browser is sent back to after a successful sign-in.
OAUTH_PUBLIC_BASE_URL=http://localhost:8123
OAUTH_FRONTEND_URL=http://localhost:8123
# No-credentials sign-in into one shared, low-quota tenant.
ENABLE_GUEST_MODE=true
GUEST_TENANT_ID=guest
GUEST_RPM=5
GUEST_RPD=50

# --- Rate limiting and answer cache (Phase 4) ---
# Defaults for a newly enrolled tenant; its config row overrides them.
DEFAULT_RPM=10
DEFAULT_RPD=500
ANSWER_CACHE_TTL_S=900
RATE_LIMIT_ENABLED=true
ANSWER_CACHE_ENABLED=true

# --- LLM providers ---
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=60

# Default tier for classify / manager / judge / synthesis. "groq" is the
# workhorse; "premium" puts Gemini first and is opt-in per tenant via the
# model_tier column on its config row.
LLM_TIER=groq

# Cheap model for the groundedness judge and schema repair. Free-tier quota is
# metered per model, so a separate judge model spreads load across buckets.
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite

# --- Free-tier throttling (Phase 3) ---
# Seconds enforced between provider calls; 0 disables throttling.
LLM_MIN_INTERVAL_S=0
# On-disk LLM response cache. Set by `make eval` so re-runs are near-free.
LLM_CACHE_DIR=
LLM_MAX_RETRIES=2

# --- Retrieval ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384
RETRIEVE_TOP_K=50
RERANK_TOP_K=5
RERANK_MODEL=ms-marco-MiniLM-L-12-v2
RRF_K=60

# --- Tenancy (Phase 1: single tenant) ---
DEFAULT_TENANT=demo

# --- Ingestion ---
CORPUS_DIR=data/corpus
BM25_INDEX_DIR=data/indexes
CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=150

# --- Serving and CORS (Phase 6) ---
# Empty = same-origin only, which is how the deployed stack runs (the API serves
# the built UI). Name a UI origin explicitly if you host it separately.
# NEVER "*": bearer tokens + wildcard origin lets any page spend a tenant's quota.
CORS_ALLOW_ORIGINS=
SERVE_UI=true
STATIC_DIR=web/dist

# --- Deploy ---
# From the Cloudflare Zero Trust dashboard. Only needed with `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=
APP_PORT=8000
